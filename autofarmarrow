--[[
	ARROW AUTO FARM v3.3 (mobile, no-synthetic-key)
	Target: Workspace.Game.ItemSpawnNodes.Arrows.Arrow01 -> Arrow09
	Pickup: ProximityPrompt / ClickDetector / touch — NO keypress()
	Use: execute, then click START FARM.
]]

local Players    = game:GetService("Players")
local Workspace  = game:GetService("Workspace")
local UIS        = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LP = Players.LocalPlayer

if getgenv and getgenv()._ArrowFarmCleanup then
	pcall(getgenv()._ArrowFarmCleanup)
end

local IS_MOBILE = UIS.TouchEnabled and not UIS.MouseEnabled

local CONFIG = {
	Prefix       = "Arrow",
	Min          = 1,
	Max          = 9,
	WaitAtArrow  = IS_MOBILE and 0.8 or 0.4,
	OffsetY      = 3,
	GrabRadius   = 20,
	PostFarmWait = IS_MOBILE and 0.3 or 0.1,
	AnchorWindow = 0.35,
	PromptHold   = 0.5,
}

local state = {
	running    = false,
	current    = "-",
	arrowsDone = 0,
	selected   = {},
	detect     = "scanning…",
}

for i = CONFIG.Min, CONFIG.Max do
	state.selected[string.format("%s%02d", CONFIG.Prefix, i)] = true
end

--------------------------------------------------------------------
-- WORLD
--------------------------------------------------------------------
local function getGameModel()
	return Workspace:FindFirstChild("Game") or Workspace:FindFirstChild("Game", true)
end

local function getArrowsFolder()
	local g = getGameModel()
	if not g then return nil end
	local nodes = g:FindFirstChild("ItemSpawnNodes")
	if not nodes then return nil end
	return nodes:FindFirstChild("Arrows")
end

local function getRoot()
	local char = LP.Character
	if not char or not char.Parent then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then return hrp, hum, char end
	return nil
end

local function getArrow(name)
	local folder = getArrowsFolder()
	if not folder then return nil end
	local node = folder:FindFirstChild(name)
	if node and node:IsA("BasePart") then return node end
	return nil
end

local function getSelectedArrows()
	local list = {}
	for i = CONFIG.Min, CONFIG.Max do
		local name = string.format("%s%02d", CONFIG.Prefix, i)
		if state.selected[name] then
			local part = getArrow(name) or getArrow(CONFIG.Prefix .. i)
			if part then list[#list + 1] = part end
		end
	end
	return list
end

--------------------------------------------------------------------
-- TELEPORT (anchored — proven working by TEST TP)
--------------------------------------------------------------------
local function teleportTo(pos)
	local hrp, hum, char = getRoot()
	if not hrp then return false end

	local wasAnchored = hrp.Anchored
	pcall(function() hrp.Anchored = true end)
	pcall(function()
		hrp.CFrame = CFrame.new(pos)
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)

	local t0 = tick()
	while tick() - t0 < CONFIG.AnchorWindow do
		RunService.Heartbeat:Wait()
	end

	pcall(function() hrp.Anchored = wasAnchored end)

	local hrp2 = getRoot()
	if not hrp2 then return false end
	if (hrp2.Position - pos).Magnitude <= 10 then return true end

	pcall(function() char:PivotTo(CFrame.new(pos)) end)
	task.wait(IS_MOBILE and 0.2 or 0.1)
	hrp2 = getRoot()
	if not hrp2 then return false end
	return (hrp2.Position - pos).Magnitude <= 12
end

--------------------------------------------------------------------
-- GRAB  — NO keypress. Only prompt / click / touch.
--------------------------------------------------------------------
local function firePrompts(inst)
	if not inst or not inst.Parent then return 0 end
	local prompts, maxHold = {}, 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			prompts[#prompts + 1] = d
			maxHold = math.max(maxHold, d.HoldDuration or 0)
		end
	end
	if #prompts == 0 then return 0 end
	maxHold = math.min(maxHold, CONFIG.PromptHold)

	for _, p in ipairs(prompts) do
		if p and p.Parent then pcall(function() p:InputHoldBegin() end) end
	end
	if maxHold > 0 then task.wait(maxHold + 0.05) end
	for _, p in ipairs(prompts) do
		if p and p.Parent then pcall(function() p:InputHoldEnd() end) end
	end
	return #prompts
end

local function fireClicks(inst)
	if type(fireclickdetector) ~= "function" then return 0 end
	if not inst or not inst.Parent then return 0 end
	local n = 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ClickDetector") and d.Parent then
			n += 1
			pcall(function() fireclickdetector(d) end)
		end
	end
	return n
end

local function fireTouch(part, hrp)
	if type(firetouchinterest) ~= "function" then return false end
	if not part or not part.Parent or not hrp or not hrp.Parent then return false end
	if hrp.Anchored then return false end
	pcall(function() firetouchinterest(part, hrp, 0) end)
	task.defer(function()
		if part and part.Parent and hrp and hrp.Parent and not hrp.Anchored then
			pcall(function() firetouchinterest(part, hrp, 1) end)
		end
	end)
	return true
end

local function grabArrow(arrow, hrp)
	-- Try every non-key interaction method on the arrow itself
	local n = 0
	n += firePrompts(arrow)
	n += fireClicks(arrow)
	fireTouch(arrow, hrp)

	-- Also sweep nearby parts once (some games put the prompt on a child)
	local folder = getArrowsFolder()
	local container = folder and folder.Parent
	if container and hrp and hrp.Parent then
		local touched = 0
		for _, d in ipairs(container:GetDescendants()) do
			if touched >= (IS_MOBILE and 3 or 6) then break end
			if d:IsA("BasePart") and d ~= arrow and d.Parent
			and (d.Position - hrp.Position).Magnitude <= CONFIG.GrabRadius then
				touched += 1
				firePrompts(d)
				fireClicks(d)
				fireTouch(d, hrp)
				task.wait(IS_MOBILE and 0.06 or 0.03)
			end
		end
	end

	return n > 0
end

local function farmArrow(arrow)
	if not arrow or not arrow.Parent then return false end
	local hrp = getRoot()
	if not hrp then return false end

	local pos = arrow.Position + Vector3.new(0, CONFIG.OffsetY, 0)
	local reached = teleportTo(pos)

	hrp = getRoot()
	if not hrp then return false end

	task.wait(CONFIG.WaitAtArrow)
	hrp = getRoot()
	if not hrp then return false end

	grabArrow(arrow, hrp)
	return reached
end

--------------------------------------------------------------------
-- LOOP
--------------------------------------------------------------------
local alive = true

task.spawn(function()
	while alive do
		if state.running then
			pcall(function()
				local folder = getArrowsFolder()
				if not folder then
					state.detect = "Arrows folder NOT FOUND"
					refreshUI()
					task.wait(1)
					return
				end

				local arrows = getSelectedArrows()
				state.detect = string.format("%d arrow(s) detected", #arrows)
				refreshUI()

				if #arrows == 0 then
					task.wait(0.5)
					return
				end

				for _, arrow in ipairs(arrows) do
					if not state.running or not alive then break end
					if not arrow or not arrow.Parent then continue end

					state.current = arrow.Name
					refreshUI()

					local ok = false
					pcall(function() ok = farmArrow(arrow) end)
					if ok then state.arrowsDone += 1 end
					refreshUI()
					task.wait(CONFIG.PostFarmWait)
				end
			end)
		end
		task.wait(state.running and 0 or 0.15)
	end
end)

