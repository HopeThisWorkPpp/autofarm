local arrowButtons = {}
for i = CONFIG.Min, CONFIG.Max do
	local name = string.format("%s%02d", CONFIG.Prefix, i)
	local b = new("TextButton",{LayoutOrder=i,BackgroundColor3=THEME.card,Font=Enum.Font.GothamBold,TextSize=11,Text="0"..i,TextColor3=THEME.sub,AutoButtonColor=false},grid)
	corner(b,7)
	local st = new("UIStroke",{Color=THEME.stroke,Thickness=1},b)
	arrowButtons[name] = {btn=b,stroke=st}
	b.MouseButton1Click:Connect(function()
		state.selected[name] = not state.selected[name]; refreshUI()
	end)
end

function refreshUI()
	if state.running then
		startBtn.Text="STOP FARM"; startBtn.BackgroundColor3=THEME.danger
		startBtn.TextColor3=Color3.fromRGB(255,245,245)
		dot.BackgroundColor3=THEME.accent
		statusLbl.Text = state.current~="-" and ("Farming · "..state.current) or "Farming…"
		statusLbl.TextColor3=THEME.text
	else
		startBtn.Text="START FARM"; startBtn.BackgroundColor3=THEME.accent
		startBtn.TextColor3=Color3.fromRGB(12,24,16)
		dot.BackgroundColor3=THEME.sub
		statusLbl.Text="Idle"; statusLbl.TextColor3=THEME.sub
	end
	infoLbl.Text = string.format("%s  ·  Trips: %d",state.detect,state.arrowsDone)
	for name,o in pairs(arrowButtons) do
		if state.selected[name] then
			o.btn.BackgroundColor3=Color3.fromRGB(32,58,44)
			o.btn.TextColor3=THEME.accent; o.stroke.Color=THEME.accent
		else
			o.btn.BackgroundColor3=THEME.card
			o.btn.TextColor3=THEME.sub; o.stroke.Color=THEME.stroke
		end
	end
end

startBtn.MouseButton1Click:Connect(function()
	state.running = not state.running
	if not state.running then state.current="-" end
	refreshUI()
end)

local minimized=false
minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	body.Visible = not minimized
	win.Size = minimized and UDim2.fromOffset(WIN_W,40) or UDim2.fromOffset(WIN_W,WIN_H)
	minBtn.Text = minimized and "+" or "—"
end)

do
	local dragging,dragStart,startPos=false,nil,nil
	bar.InputBegan:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
		or input.UserInputType==Enum.UserInputType.Touch then
			dragging=true; dragStart=input.Position; startPos=win.Position
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType==Enum.UserInputType.MouseMovement
		or input.UserInputType==Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			win.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType==Enum.UserInputType.MouseButton1
		or input.UserInputType==Enum.UserInputType.Touch then dragging=false end
	end)
end

do
	local folder = getArrowsFolder()
	if folder then
		local n=0
		for _,c in ipairs(folder:GetChildren()) do if c:IsA("BasePart") then n+=1 end end
		state.detect=string.format("%d arrow(s)",n)
	else
		state.detect="Arrows folder NOT FOUND"
	end
end

refreshUI()

if getgenv then
	getgenv()._ArrowFarmCleanup = function()
		alive=false; state.running=false
		pcall(function() gui:Destroy() end)
	end
end

