--[[
	ARROW AUTO FARM v4 (anti-cheat safe)
	- Single CFrame teleport (no anchoring)
	- 1.3s between arrows (realistic movement)
	- No firetouchinterest / fireclickdetector
	- ProximityPrompt only as fallback
	- One arrow at a time so you can see which one crashes
]]

local Players    = game:GetService("Players")
local Workspace  = game:GetService("Workspace")
local UIS        = game:GetService("UserInputService")

local LP = Players.LocalPlayer
if getgenv and getgenv()._ArrowFarmCleanup then
	pcall(getgenv()._ArrowFarmCleanup)
end

local CONFIG = {
	Prefix       = "Arrow",
	Min          = 1,
	Max          = 9,
	WaitAtArrow  = 1.3,    -- slow on purpose — realistic movement
	OffsetY      = 3,
	PostFarmWait = 0.4,
}

local state = {
	running = false,
	current = "-",
	arrowsDone = 0,
	selected = {},
	detect = "scanning…",
}
for i = CONFIG.Min, CONFIG.Max do
	-- Only Arrow01 selected by default — user enables more after verifying it works
	state.selected[string.format("%s%02d", CONFIG.Prefix, i)] = (i == 1)
end

local function getGameModel()
	return Workspace:FindFirstChild("Game") or Workspace:FindFirstChild("Game", true)
end
local function getArrowsFolder()
	local g = getGameModel(); if not g then return nil end
	local n = g:FindFirstChild("ItemSpawnNodes"); if not n then return nil end
	return n:FindFirstChild("Arrows")
end
local function getRoot()
	local char = LP.Character
	if not char or not char.Parent then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then return hrp, hum, char end
	return nil
end
local function getArrow(name)
	local folder = getArrowsFolder(); if not folder then return nil end
	local node = folder:FindFirstChild(name)
	if node and node:IsA("BasePart") then return node end
	return nil
end
local function getSelectedArrows()
	local list = {}
	for i = CONFIG.Min, CONFIG.Max do
		local name = string.format("%s%02d", CONFIG.Prefix, i)
		if state.selected[name] then
			local p = getArrow(name) or getArrow(CONFIG.Prefix .. i)
			if p then list[#list + 1] = p end
		end
	end
	return list
end

-- ONE teleport method. No anchoring. No PivotTo fallback. No velocity zeroing.
-- Just set CFrame and let the game's network ownership handle it.
local function teleportTo(pos)
	local hrp = getRoot()
	if not hrp then return false end
	local ok = pcall(function() hrp.CFrame = CFrame.new(pos) end)
	if not ok then return false end
	task.wait(0.15)
	local hrp2 = getRoot()
	if not hrp2 then return false end
	return (hrp2.Position - pos).Magnitude <= 15
end

-- Only ProximityPrompt. No firetouchinterest. No fireclickdetector.
local function tryPrompt(inst)
	if not inst or not inst.Parent then return false end
	local fired = false
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			local ok = pcall(function()
				d:InputHoldBegin()
				task.wait(math.min(d.HoldDuration or 0, 0.4) + 0.05)
				d:InputHoldEnd()
			end)
			if ok then fired = true end
		end
	end
	return fired
end

local function farmArrow(arrow)
	if not arrow or not arrow.Parent then return false end
	local hrp = getRoot(); if not hrp then return false end

	local pos = arrow.Position + Vector3.new(0, CONFIG.OffsetY, 0)
	local reached = teleportTo(pos)

	hrp = getRoot(); if not hrp then return false end
	task.wait(CONFIG.WaitAtArrow)
	hrp = getRoot(); if not hrp then return false end

	tryPrompt(arrow)
	return reached
end

local alive = true
task.spawn(function()
	while alive do
		if state.running then
			pcall(function()
				local arrows = getSelectedArrows()
				state.detect = string.format("%d arrow(s)", #arrows)
				refreshUI()
				if #arrows == 0 then task.wait(0.5); return end
				for _, a in ipairs(arrows) do
					if not state.running or not alive then break end
					if not a or not a.Parent then continue end
					state.current = a.Name; refreshUI()
					local ok = false
					pcall(function() ok = farmArrow(a) end)
					if ok then state.arrowsDone += 1 end
					refreshUI()
					task.wait(CONFIG.PostFarmWait)
				end
			end)
		end
		task.wait(state.running and 0 or 0.2)
	end
end)

