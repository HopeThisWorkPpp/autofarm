-- CONFIG
--------------------------------------------------------------------
local CONFIG = {
	Prefix      = "Arrow",
	Min         = 1,
	Max         = 9,
	WaitAtArrow = 0.35,
	OffsetY     = 3,
	GrabRadius  = 16,
	GrabKey     = Enum.KeyCode.H,
	ToggleKey   = Enum.KeyCode.RightShift,
	MaxSweep    = 8,      -- hard cap on parts touched per grabAround
	PostFarmWait = 0.1,   -- yield between farm iterations
}

local state = {
	running    = false,
	current    = "-",
	arrowsDone = 0,
	selected   = {},
	detect     = "scanning…",
}

for i = CONFIG.Min, CONFIG.Max do
	state.selected[string.format("%s%02d", CONFIG.Prefix, i)] = true
end

--------------------------------------------------------------------
-- KEY PRESS  (H)
--------------------------------------------------------------------
local keyMethod = "none"

local function sendKey(key)
	if type(keypress) == "function" then
		local code = (key == Enum.KeyCode.H) and 0x48 or 0x48
		local ok = pcall(function()
			keypress(code)
			task.wait(0.03)
			keyrelease(code)
		end)
		if ok then keyMethod = "keypress()"; return true end
	end

	local ok2 = pcall(function()
		VIM:SendKeyEvent(true, key, false, game)
		task.wait(0.03)
		VIM:SendKeyEvent(false, key, false, game)
	end)
	if ok2 then keyMethod = "VirtualInputManager"; return true end

	keyMethod = "FAILED"
	return false
end

local function pressGrabKey(times)
	for _ = 1, (times or 2) do
		sendKey(CONFIG.GrabKey)
		task.wait(0.07)
	end
end

--------------------------------------------------------------------
-- WORLD
--------------------------------------------------------------------
local function getGameModel()
	return Workspace:FindFirstChild("Game") or Workspace:FindFirstChild("Game", true)
end

local function getArrowsFolder()
	local g = getGameModel()
	if not g then return nil end
	local nodes = g:FindFirstChild("ItemSpawnNodes")
	if not nodes then return nil end
	return nodes:FindFirstChild("Arrows")
end

local function getRoot()
	local char = LP.Character
	if not char or not char.Parent then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hum and hrp and hum.Health > 0 then return hrp, hum, char end
	return nil
end

local function getArrow(name)
	local folder = getArrowsFolder()
	if not folder then return nil end
	local node = folder:FindFirstChild(name)
	if node and node:IsA("BasePart") then return node end
	return nil
end

local function getSelectedArrows()
	local list = {}
	for i = CONFIG.Min, CONFIG.Max do
		local name = string.format("%s%02d", CONFIG.Prefix, i)
		if state.selected[name] then
			local part = getArrow(name) or getArrow(CONFIG.Prefix .. i)
			if part then list[#list + 1] = part end
		end
	end
	return list
end

--------------------------------------------------------------------
-- TELEPORT  (no MoveTo — that was the crash)
--------------------------------------------------------------------
local function teleportTo(pos)
	local hrp, hum, char = getRoot()
	if not hrp then return false end

	-- method 1: root part CFrame
	pcall(function()
		hrp.CFrame = CFrame.new(pos)
		hrp.AssemblyLinearVelocity  = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)
	task.wait(0.1)
	if (hrp.Position - pos).Magnitude <= 6 then return true end

	-- method 2: pivot entire character
	pcall(function() char:PivotTo(CFrame.new(pos)) end)
	task.wait(0.15)
	if (hrp.Position - pos).Magnitude <= 6 then return true end

	-- deliberately NOT using hum:MoveTo — it fights the next teleport and crashes
	return false
end

--------------------------------------------------------------------
-- GRAB
--------------------------------------------------------------------
local function usePrompts(inst)
	if not inst or not inst.Parent then return end
	local prompts, maxHold = {}, 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Enabled then
			prompts[#prompts + 1] = d
			maxHold = math.max(maxHold, d.HoldDuration or 0)
		end
	end
	if #prompts == 0 then return end

	-- cap hold time so we never block the loop for more than ~0.5s
	maxHold = math.min(maxHold, 0.5)

	for _, p in ipairs(prompts) do
		if p and p.Parent then pcall(function() p:InputHoldBegin() end) end
	end
	if maxHold > 0 then task.wait(maxHold + 0.05) end
	for _, p in ipairs(prompts) do
		if p and p.Parent then pcall(function() p:InputHoldEnd() end) end
	end
end

local function clickOn(inst)
	if type(fireclickdetector) ~= "function" then return end
	if not inst or not inst.Parent then return end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("ClickDetector") and d.Parent then
			pcall(function() fireclickdetector(d) end)
		end
	end
end

local function touchPart(part, hrp)
	if type(firetouchinterest) ~= "function" then return end
	if not part or not part.Parent or not hrp or not hrp.Parent then return end
	pcall(function() firetouchinterest(part, hrp, 0) end)
	task.defer(function()
		if part and part.Parent and hrp and hrp.Parent then
			pcall(function() firetouchinterest(part, hrp, 1) end)
		end
	end)
end

local function grabAround(hrp, skip)
	if not hrp or not hrp.Parent then return end
	pressGrabKey(2)

	local folder = getArrowsFolder()
	local container = folder and folder.Parent
	if not container then return end

	local touched = 0
	for _, d in ipairs(container:GetDescendants()) do
		if touched >= CONFIG.MaxSweep then break end
		if d:IsA("BasePart") and d ~= skip and d.Parent
		and (d.Position - hrp.Position).Magnitude <= CONFIG.GrabRadius then
			touched += 1
			clickOn(d)
			touchPart(d, hrp)
			task.wait(0.02)
		end
	end
end

local function farmArrow(arrow)
	if not arrow or not arrow.Parent then return false end
	local hrp = getRoot()
	if not hrp then return false end

	local pos = arrow.Position + Vector3.new(0, CONFIG.OffsetY, 0)
	local reached = teleportTo(pos)

	-- re-validate character after the yield
	hrp = getRoot()
	if not hrp then return false end

	-- primary: press H
	pressGrabKey(2)

	-- re-validate again (keypress yields ~0.14s)
	hrp = getRoot()
	if not hrp then return false end

	task.wait(math.max(CONFIG.WaitAtArrow - 0.14, 0.03))

	-- secondary: prompts / clicks / touch (only on this arrow)
	usePrompts(arrow)
	clickOn(arrow)
	touchPart(arrow, hrp)

	-- final sweep — capped
	grabAround(hrp, arrow)

	return reached
end

--------------------------------------------------------------------
-- LOOP
--------------------------------------------------------------------
local alive = true

task.spawn(function()
	while alive do
		if state.running then
			local folder = getArrowsFolder()
			if not folder then
				state.detect = "Arrows folder NOT FOUND"
				refreshUI()
				task.wait(1)
			else
				local arrows = getSelectedArrows()
				state.detect = string.format("%d arrow(s) detected", #arrows)
				refreshUI()

				if #arrows == 0 then
					task.wait(0.5)
				else
					for _, arrow in ipairs(arrows) do
						if not state.running or not alive then break end
						if not arrow.Parent then continue end

						state.current = arrow.Name
						refreshUI()

						local ok = farmArrow(arrow)
						if ok then state.arrowsDone += 1 end
						refreshUI()

						task.wait(CONFIG.PostFarmWait)
					end
				end
			end
		end
		task.wait(state.running and 0 or 0.15)
	end
end)

