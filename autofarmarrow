		dot.BackgroundColor3 = THEME.accent
		statusLbl.Text = state.current ~= "-" and ("Farming · " .. state.current) or "Farming…"
		statusLbl.TextColor3 = THEME.text
	else
		startBtn.Text = "START FARM  (no keypress)"
		startBtn.BackgroundColor3 = THEME.accent
		startBtn.TextColor3 = Color3.fromRGB(12, 24, 16)
		dot.BackgroundColor3 = THEME.sub
		statusLbl.Text = "Idle"
		statusLbl.TextColor3 = THEME.sub
	end
	infoLbl.Text = string.format("%s  ·  Trips: %d", state.detect, state.arrowsDone)
	for name, o in pairs(arrowButtons) do
		if state.selected[name] then
			o.btn.BackgroundColor3 = Color3.fromRGB(32, 58, 44)
			o.btn.TextColor3 = THEME.accent
			o.stroke.Color = THEME.accent
		else
			o.btn.BackgroundColor3 = THEME.card
			o.btn.TextColor3 = THEME.sub
			o.stroke.Color = THEME.stroke
		end
	end
end

